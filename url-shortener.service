[Unit]
Description=URL shortener web app
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/url-shortener
EnvironmentFile=/etc/url-shortener.env
ExecStart=/home/ubuntu/url-shortener/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 80
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target